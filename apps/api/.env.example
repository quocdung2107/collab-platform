# Chuỗi kết nối PostgreSQL (Supabase: Project Settings → Database → Connection string, chế độ Session).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collab
# URL dự án Supabase, dùng để lấy JWKS và kiểm tra iss của JWT.
SUPABASE_URL=https://<project-ref>.supabase.co
# Khoá máy chủ (service_role / sb_secret_…) để bật tệp đính kèm; bỏ trống = tắt tệp.
# SUPABASE_SERVICE_KEY=
# Nguồn web được phép gọi API (CORS), phân tách bằng dấu phẩy.
WEB_ORIGINS=http://localhost:5173
PORT=8080
# supabase | none (none khi chạy với Postgres thường, không có schema realtime)
REALTIME_DRIVER=supabase
