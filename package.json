{
  "name": "collab-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @collab/api db:migrate",
    "dev:api": "pnpm --filter @collab/api dev",
    "dev:web": "pnpm --filter @collab/web dev"
  }
}
